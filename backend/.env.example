# =============================================================================
# Enterprise Auth System — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=8h

# Shorter-lived token issued after step 1 (password OK, awaiting 2FA)
JWT_2FA_PENDING_EXPIRES_IN=5m

# ── Cryptography ─────────────────────────────────────────────────────────────
# !! CRITICAL !! If this value is lost, ALL passwords become unrecoverable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_PEPPER=REPLACE_WITH_32_BYTE_HEX_STRING

# ── PostgreSQL / Supabase ─────────────────────────────────────────────────────
# Option 1: Supabase / Cloud connection string (recommended if using Supabase):
# Example: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Option 2: Local PostgreSQL connection parameters (ignored if DATABASE_URL is set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_auth
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD
# Set to 'true' to enable SSL (recommended for production)
DB_SSL=false

# ── Backup ────────────────────────────────────────────────────────────────────
# AES-256-CBC key (must be 64 hex chars = 32 bytes)
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_BYTE_HEX_STRING
# Path to pg_dump binary (leave blank to use system PATH)
PG_DUMP_PATH=pg_dump
# Directory where encrypted backups are stored
BACKUP_DIR=./backups
# Days to retain backups before auto-deletion
BACKUP_RETENTION_DAYS=30
# Cron schedule (default: daily at midnight)
BACKUP_CRON=0 0 * * *

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max login attempts per IP per window
RATE_LIMIT_MAX=10
# Window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ── Email OTP / Gmail SMTP (2FA Backup) ───────────────────────────────────────
# Gmail account used to send the 6-digit OTP verification emails
GMAIL_USER=your_email@gmail.com
# Google App Password (generate at https://myaccount.google.com/apppasswords)
# Select "Mail" -> "Other" to generate a 16-character token
GMAIL_APP_PASSWORD=your_16_character_app_password

