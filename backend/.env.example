# =============================================================================
# Enterprise Auth System — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=8h
JWT_2FA_PENDING_EXPIRES_IN=5m

# ── Cryptography ────────────────────────────────────────────────────────────
# Losing this value makes passwords unrecoverable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_PEPPER=REPLACE_WITH_32_BYTE_HEX_STRING

# ── Hosted Supabase database ──────────────────────────────────────────────────
# Local development and the backend connect directly to this hosted database.
SUPABASE_DATABASE_URL=

# Encrypted cloud backups. Default destination is Google Drive.
BACKUP_STORAGE_PROVIDER=google_drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# ── Encrypted Supabase Storage backups ───────────────────────────────────────
# Only needed when BACKUP_STORAGE_PROVIDER=supabase; the bucket must be private.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New API key (recommended for the backend):
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY
# Storage also requires the legacy service_role JWT in Authorization:
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_JWT
SUPABASE_BACKUP_BUCKET=enterprise-auth-backups
AWS_INCIDENT_EVIDENCE_BUCKET=
# AES-256-GCM key (64 hex chars = 32 bytes). Keep outside Supabase Storage.
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_BYTE_HEX_STRING
BACKUP_MAX_BYTES=52428800

# ── AWS incident evidence storage ─────────────────────────────────────────────
# Use an IAM role for AWS access. Do not store AWS access keys in this file.
AWS_REGION=us-east-1

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Optional hosted frontend URL used by user setup invitations.
ACCOUNT_SETUP_URL=

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# ── Email OTP / Gmail SMTP (2FA Backup) ──────────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
