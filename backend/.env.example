# =============================================================================
# Enterprise Auth System — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=8h
JWT_2FA_PENDING_EXPIRES_IN=5m

# ── Cryptography ─────────────────────────────────────────────────────────────
# Losing this value makes passwords unrecoverable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_PEPPER=REPLACE_WITH_32_BYTE_HEX_STRING

# ── Local-primary PostgreSQL ──────────────────────────────────────────────────
# App reads/writes only this local database; DATABASE_URL is intentionally ignored.
LOCAL_DATABASE_URL=postgresql://postgres@localhost:5432/enterprise_auth
LOCAL_DATABASE_PASSWORD=REPLACE_WITH_YOUR_LOCAL_POSTGRES_PASSWORD
LOCAL_DATABASE_SSL=false

# Supabase connection reserved for the synchronization service.
SUPABASE_DATABASE_URL=
SYNC_CRON=* * * * *

# ── Encrypted backups ─────────────────────────────────────────────────────────
# AES-256-GCM key (64 hex chars = 32 bytes)
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_BYTE_HEX_STRING
PG_DUMP_PATH=pg_dump
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 0 * * *

# Absolute path to an existing folder mirrored by Google Drive for desktop.
# Enable "Mirror files" so encrypted backups remain locally available offline.
GOOGLE_DRIVE_SYNC_DIR=REPLACE_WITH_ABSOLUTE_GOOGLE_DRIVE_FOLDER_PATH

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# ── Email OTP / Gmail SMTP (2FA Backup) ───────────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
